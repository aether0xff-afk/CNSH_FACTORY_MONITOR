{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cnsh-factory-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "vpc_services": [
    {
      "binding": "FACTORY_SERVICE",
      "service_id": "REPLACE_WITH_YOUR_VPC_SERVICE_ID",
      "remote": true
    }
  ]
}
